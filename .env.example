# Psychologue Intelligent V2 — modèle de configuration.
# Copier en `.env` pour un usage local hors Docker. En Docker, docker-compose.yml
# fournit déjà ces valeurs. AUCUN secret réel ne doit être committé (ADR-006, §95).

PI_ENV=development

# Base transactionnelle (source de vérité)
# Ports hôte décalés (voir docker-compose.yml). Depuis le conteneur api, utiliser
# les noms de service (postgres:5432, redis:6379, rabbitmq:5672).
PI_DATABASE_URL=postgresql+asyncpg://pi:pi_dev_only@localhost:55432/psychologue_intelligent
PI_DATABASE_URL_SYNC=postgresql+psycopg://pi:pi_dev_only@localhost:55432/psychologue_intelligent

# Cache / état éphémère
PI_REDIS_URL=redis://localhost:56379/0

# Messaging
PI_RABBITMQ_URL=amqp://pi:pi_dev_only@localhost:55672/

# Observabilité
PI_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
PI_OTEL_SERVICE_NAME=pi-api

# Signature des jetons de session (opaques côté client, ce secret signe les métadonnées serveur)
# Générer une vraie valeur avec: python -c "import secrets; print(secrets.token_urlsafe(48))"
PI_JWT_SIGNING_KEY=dev-only-not-a-real-secret-change-me

# Notification e-mail (dev: mailpit)
PI_SMTP_HOST=localhost
PI_SMTP_PORT=1025

# LLM externe (chemin DEEP, ADR-007) — laisser vide désactive le chemin externe
PI_LLM_EXTERNAL_PROVIDER=
PI_LLM_EXTERNAL_API_KEY=
